pessoas = 15
maior_altura = 0.0
menor_altura = 0.0

soma_altura = 0.0
qtd_masculino = 0

qtd_feminino = 0

print("Digite os dados das pessoas")

for i in range(1, pessoas + 1):
    print(f"\nPessoa de numero {i}:")
    
    altura = float(input("Digite a altura: "))
   
    if i == 1:
        maior_altura = altura
        menor_altura = altura
    else:
       
        if altura > maior_altura:
            maior_altura = altura
        
       
        if altura < menor_altura:
            menor_altura = altura
    
    genero = input("Digite o gênero da pessoa, M para Masculino e F para Feminino): ")
    while genero != 'M' and genero != 'F':
        genero = input("Gênero inválido! Digite apenas 'M' ou 'F': ")
        
    if genero == 'M':
        soma_altura += altura
        qtd_masculino += 1
    elif genero == 'F':
        qtd_feminino += 1


if qtd_masculino > 0:
    media_masculino = soma_altura / qtd_masculino
    resultado_media_m = f"{media_masculino:} m"
else:
    resultado_media_m = "Sem homens registrados."


print("Dados das pessoas")
print(f" Maior altura do grupo: {maior_altura:} m")
print(f" Menor altura do grupo: {menor_altura:} m")
print(f" Média de altura (Masculino): {resultado_media_m}")
print(f" Número de pessoas do gênero Feminino: {qtd_feminino}")


